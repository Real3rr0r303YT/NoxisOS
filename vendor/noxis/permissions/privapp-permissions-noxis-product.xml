        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    </privapp-permissions>
    <privapp-permissions package="com.real3rr0r303yt.nothingcall.debug">
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    </privapp-permissions>
</permissions>
